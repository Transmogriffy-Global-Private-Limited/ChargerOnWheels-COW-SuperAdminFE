---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Charger on Wheels - Super Admin Portal"
    />
    <title>Charger On Wheels Super Admin</title>
  </head>

  <body class="min-h-screen bg-slate-950 text-white antialiased">

    <!-- Background Glow -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -left-40 -top-40 h-125 w-125 rounded-full bg-cyan-500/10 blur-3xl"
      ></div>

      <div
        class="absolute -right-40 top-20 h-125 w-125 rounded-full bg-blue-600/10 blur-3xl"
      ></div>

      <div
        class="absolute bottom-0 left-1/3 h-125 w-125 rounded-full bg-indigo-600/10 blur-3xl"
      ></div>
    </div>

    <!-- ================= NAVBAR ================= -->

    <header class="border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8"
      >

        <!-- Logo -->
        <div class="flex items-center gap-3">

          <div
            class="flex h-11 w-11 items-center justify-center rounded-xl bg-linear-to-br from-cyan-400 to-blue-600 shadow-lg shadow-cyan-500/20"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              />
            </svg>
          </div>

          <div>
            <h1 class="text-lg font-bold tracking-tight">
              Charger<span class="text-cyan-400">OnWheels</span>
            </h1>

            <p class="text-xs text-slate-400">
              Super Admin Portal
            </p>
          </div>
        </div>

        <!-- Right Side -->
        <div class="flex items-center gap-3 sm:gap-5">

          <!-- System Status -->
          <div
            class="hidden items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2 text-xs font-medium text-emerald-400 sm:flex"
          >
            <span
              class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"
            ></span>

            System Online
          </div>

          <!-- Admin -->
          <div class="flex items-center gap-2">

            <div
              class="flex h-10 w-10 items-center justify-center rounded-full bg-linear-to-br from-cyan-400 to-blue-600 text-sm font-bold"
            >
              SA
            </div>

            <div class="hidden sm:block">
              <p class="text-sm font-medium">Super Admin</p>
              <p class="text-xs text-slate-500">Administrator</p>
            </div>

          </div>

        </div>
      </div>
    </header>


    <!-- ================= MAIN ================= -->

    <main class="mx-auto max-w-7xl px-5 py-12 sm:px-6 lg:px-8">

      <!-- ================= HERO ================= -->

      <section class="grid items-center gap-12 lg:grid-cols-2">

        <!-- Left -->
        <div>

          <!-- Badge -->
          <div
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-cyan-400/10 px-4 py-2 text-sm font-medium text-cyan-300"
          >
            <span
              class="h-2 w-2 animate-pulse rounded-full bg-cyan-400"
            ></span>

            EV Charging Management Platform
          </div>


          <!-- Heading -->
          <h2
            class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
          >
            Powering the
            <span
              class="bg-linear-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent"
            >
              future of mobility.
            </span>
          </h2>


          <!-- Description -->
          <p
            class="mt-6 max-w-xl text-base leading-7 text-slate-400 sm:text-lg"
          >
            Manage your EV charging network, monitor chargers, track
            transactions and keep your entire charging ecosystem under control
            from one powerful platform.
          </p>


          <!-- Buttons -->
          <div class="mt-8 flex flex-wrap gap-4">

            <a
              href="/dashboard"
              class="inline-flex items-center gap-2 rounded-xl bg-cyan-500 px-6 py-3.5 font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition duration-200 hover:bg-cyan-400 hover:shadow-cyan-400/30"
            >
              Go to Dashboard

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </a>


            <a
              href="/dashboard/chargers"
              class="inline-flex items-center rounded-xl border border-white/10 bg-white/5 px-6 py-3.5 font-semibold text-white transition duration-200 hover:border-cyan-400/30 hover:bg-white/10"
            >
              View Chargers
            </a>

          </div>
        </div>


        <!-- Right Dashboard Preview -->
        <div class="relative">

          <div
            class="absolute -inset-5 rounded-3xl bg-cyan-500/10 blur-3xl"
          ></div>

          <div
            class="relative rounded-3xl border border-white/10 bg-white/4 p-5 shadow-2xl backdrop-blur-xl sm:p-6"
          >

            <!-- Card Header -->
            <div class="flex items-center justify-between">

              <div>
                <p class="text-sm text-slate-400">
                  Network Overview
                </p>

                <h3 class="mt-1 text-xl font-bold">
                  Charging Network
                </h3>
              </div>

              <div
                class="flex items-center gap-2 rounded-lg bg-emerald-400/10 px-3 py-1.5 text-xs font-medium text-emerald-400"
              >
                <span
                  class="h-2 w-2 rounded-full bg-emerald-400"
                ></span>

                Live
              </div>

            </div>


            <!-- Chart -->
            <div
              class="mt-6 flex h-48 items-end gap-3 rounded-2xl border border-white/5 bg-slate-900/70 p-5"
            >

              <div class="h-[35%] flex-1 rounded-t-lg bg-cyan-500/30"></div>

              <div class="h-[48%] flex-1 rounded-t-lg bg-cyan-500/40"></div>

              <div class="h-[42%] flex-1 rounded-t-lg bg-cyan-500/40"></div>

              <div class="h-[68%] flex-1 rounded-t-lg bg-cyan-400/60"></div>

              <div class="h-[56%] flex-1 rounded-t-lg bg-cyan-400/60"></div>

              <div class="h-[82%] flex-1 rounded-t-lg bg-cyan-400"></div>

              <div class="h-[72%] flex-1 rounded-t-lg bg-blue-400"></div>

            </div>


            <!-- Mini Stats -->
            <div class="mt-5 grid grid-cols-3 gap-3">

              <div class="rounded-xl border border-white/5 bg-white/5 p-3">
                <p class="text-xs text-slate-500">
                  Chargers
                </p>

                <p class="mt-1 text-xl font-bold">
                  128
                </p>
              </div>


              <div class="rounded-xl border border-white/5 bg-white/5 p-3">
                <p class="text-xs text-slate-500">
                  Active
                </p>

                <p class="mt-1 text-xl font-bold text-emerald-400">
                  96
                </p>
              </div>


              <div class="rounded-xl border border-white/5 bg-white/5 p-3">
                <p class="text-xs text-slate-500">
                  Sessions
                </p>

                <p class="mt-1 text-xl font-bold">
                  12.4K
                </p>
              </div>

            </div>

          </div>
        </div>

      </section>


      <!-- ================= STATS ================= -->

      <section class="mt-20">

        <div class="mb-6">
          <p class="text-sm font-semibold tracking-wider text-cyan-400">
            OVERVIEW
          </p>

          <h3 class="mt-1 text-2xl font-bold">
            Network at a glance
          </h3>
        </div>


        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

          <!-- Total Chargers -->
          <div
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-cyan-400/30 hover:bg-white/6"
          >

            <div class="flex items-center justify-between">

              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-400/10 text-2xl"
              >
                ⚡
              </div>

              <span class="text-xs font-medium text-emerald-400">
                +12%
              </span>

            </div>

            <p class="mt-5 text-sm text-slate-400">
              Total Chargers
            </p>

            <p class="mt-1 text-3xl font-bold">
              128
            </p>

          </div>


          <!-- Active Chargers -->
          <div
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-emerald-400/30 hover:bg-white/6"
          >

            <div class="flex items-center justify-between">

              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-400/10 text-2xl text-emerald-400"
              >
                ✓
              </div>

              <span class="text-xs font-medium text-emerald-400">
                75%
              </span>

            </div>

            <p class="mt-5 text-sm text-slate-400">
              Active Chargers
            </p>

            <p class="mt-1 text-3xl font-bold">
              96
            </p>

          </div>


          <!-- Sessions -->
          <div
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-blue-400/30 hover:bg-white/6"
          >

            <div class="flex items-center justify-between">

              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-400/10 text-2xl text-blue-400"
              >
                ↗
              </div>

              <span class="text-xs font-medium text-emerald-400">
                +18%
              </span>

            </div>

            <p class="mt-5 text-sm text-slate-400">
              Total Sessions
            </p>

            <p class="mt-1 text-3xl font-bold">
              12,480
            </p>

          </div>


          <!-- Revenue -->
          <div
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-violet-400/30 hover:bg-white/6"
          >

            <div class="flex items-center justify-between">

              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-400/10 text-2xl text-violet-400"
              >
                ₹
              </div>

              <span class="text-xs font-medium text-emerald-400">
                +24%
              </span>

            </div>

            <p class="mt-5 text-sm text-slate-400">
              Total Revenue
            </p>

            <p class="mt-1 text-3xl font-bold">
              ₹8.42L
            </p>

          </div>

        </div>
      </section>


      <!-- ================= QUICK ACCESS ================= -->

      <section class="mt-20">

        <div class="mb-6">

          <p class="text-sm font-semibold tracking-wider text-cyan-400">
            QUICK ACCESS
          </p>

          <h3 class="mt-1 text-2xl font-bold">
            Manage your network
          </h3>

        </div>


        <div class="grid gap-5 md:grid-cols-3">

          <!-- Chargers -->
          <a
            href="/dashboard/chargers"
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-cyan-400/30 hover:bg-cyan-400/5"
          >

            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-400/10 text-2xl"
            >
              ⚡
            </div>

            <h4 class="mt-5 text-lg font-bold">
              Manage Chargers
            </h4>

            <p class="mt-2 text-sm leading-6 text-slate-400">
              View charger status, manage connectors and monitor your charging
              infrastructure.
            </p>

            <div
              class="mt-5 text-sm font-semibold text-cyan-400 transition group-hover:translate-x-1"
            >
              Open Chargers →
            </div>

          </a>


          <!-- Operations -->
          <a
            href="/dashboard/operations"
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-blue-400/30 hover:bg-blue-400/5"
          >

            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-400/10 text-2xl"
            >
              ◉
            </div>

            <h4 class="mt-5 text-lg font-bold">
              Live Operations
            </h4>

            <p class="mt-2 text-sm leading-6 text-slate-400">
              Monitor live charging sessions and keep track of your network in
              real time.
            </p>

            <div
              class="mt-5 text-sm font-semibold text-blue-400 transition group-hover:translate-x-1"
            >
              View Operations →
            </div>

          </a>


          <!-- Transactions -->
          <a
            href="/dashboard/transactions"
            class="group rounded-2xl border border-white/10 bg-white/4 p-6 transition duration-200 hover:-translate-y-1 hover:border-violet-400/30 hover:bg-violet-400/5"
          >

            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-400/10 text-2xl"
            >
              ₹
            </div>

            <h4 class="mt-5 text-lg font-bold">
              Transactions
            </h4>

            <p class="mt-2 text-sm leading-6 text-slate-400">
              Track payments, charging sessions, invoices and revenue details.
            </p>

            <div
              class="mt-5 text-sm font-semibold text-violet-400 transition group-hover:translate-x-1"
            >
              View Transactions →
            </div>

          </a>

        </div>

      </section>


      <!-- ================= SYSTEM STATUS ================= -->

      <section
        class="mt-20 rounded-3xl border border-white/10 bg-white/3 p-6 sm:p-8"
      >

        <div
          class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"
        >

          <div>

            <p class="text-sm font-semibold tracking-wider text-cyan-400">
              SYSTEM STATUS
            </p>

            <h3 class="mt-1 text-2xl font-bold">
              Everything is operational
            </h3>

          </div>


          <div
            class="flex w-fit items-center gap-2 rounded-full bg-emerald-400/10 px-4 py-2 text-sm font-medium text-emerald-400"
          >
            <span
              class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"
            ></span>

            All Systems Operational
          </div>

        </div>


        <div class="mt-8 grid gap-4 sm:grid-cols-3">

          <div
            class="flex items-center gap-4 rounded-xl border border-white/5 bg-white/5 p-4"
          >

            <div class="h-3 w-3 rounded-full bg-emerald-400"></div>

            <div>
              <p class="font-medium">
                API Services
              </p>

              <p class="text-xs text-slate-500">
                Operational
              </p>
            </div>

          </div>


          <div
            class="flex items-center gap-4 rounded-xl border border-white/5 bg-white/5 p-4"
          >

            <div class="h-3 w-3 rounded-full bg-emerald-400"></div>

            <div>
              <p class="font-medium">
                Charging Network
              </p>

              <p class="text-xs text-slate-500">
                Operational
              </p>
            </div>

          </div>


          <div
            class="flex items-center gap-4 rounded-xl border border-white/5 bg-white/5 p-4"
          >

            <div class="h-3 w-3 rounded-full bg-emerald-400"></div>

            <div>
              <p class="font-medium">
                Payment Services
              </p>

              <p class="text-xs text-slate-500">
                Operational
              </p>
            </div>

          </div>

        </div>

      </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="mt-20 border-t border-white/10">

      <div
        class="mx-auto flex max-w-7xl flex-col justify-between gap-3 px-5 py-8 text-sm text-slate-500 sm:flex-row sm:px-6 lg:px-8"
      >

        <p>
          © 2026 Charger on Wheels. All rights reserved.
        </p>

        <p>
          COW Super Admin Portal
        </p>

      </div>

    </footer>

  </body>
</html>